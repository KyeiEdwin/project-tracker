!.vscode/settings.json.example
.fleet/
.nova/
.zed/
.cursor/
*.sublime-project
*.sublime-workspace
*.code-workspace
.project
.settings/
.classpath
.c9/
nbproject/

# -----------------------------------------------------------------------------
# Testing, CI local artifacts
# -----------------------------------------------------------------------------
/tests/Browser/screenshots/
/tests/Browser/console/
/tests/Browser/source/

# -----------------------------------------------------------------------------
# Misc
